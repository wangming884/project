# ========================================
#  校园综合服务平台 - Docker 环境变量配置
#  复制本文件为 .env 并修改以下值
# ========================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=Root@123456
DB_USERNAME=campus
DB_PASSWORD=Campus@123456
MYSQL_PORT=3306

# --- Redis ---
REDIS_PASSWORD=Redis@123456
REDIS_PORT=6379

# --- 后端 ---
BACKEND_PORT=8080
JWT_SECRET=change-this-to-a-random-string-at-least-256-bits-long
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

# --- 前端 ---
FRONTEND_PORT=80

# --- 自动更新 ---
UPDATE_SECRET=campus-update-secret
